<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name"
            app:subtitle="@string/app_subtitle"
            app:menu="@menu/menu_main"
            app:navigationIcon="@drawable/ic_claw_logo"
            app:layout_scrollFlags="scroll|enterAlways|snap" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- ========================================== -->
            <!-- STATUS CARD                                -->
            <!-- Groups: Bootstrap, PicoClaw, Server        -->
            <!-- ========================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Card Header -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/card_status_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="12dp" />

                    <!-- Bootstrap Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="4dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_bootstrap"
                            android:contentDescription="@string/icon_bootstrap_desc"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="@string/label_bootstrap"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <!-- Circular spinner during bootstrap; hidden when done -->
                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/bootstrap_spinner"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorSize="24dp"
                            app:trackThickness="3dp" />

                        <!-- Bootstrap status chip -->
                        <com.google.android.material.chip.Chip
                            android:id="@+id/status_bootstrap_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_bootstrap_pending"
                            android:clickable="false"
                            android:focusable="false"
                            app:chipIcon="@drawable/ic_pending"
                            app:chipIconVisible="true"
                            app:chipIconSize="16dp"
                            app:chipMinHeight="32dp"
                            app:chipStartPadding="8dp"
                            app:chipEndPadding="8dp" />
                    </LinearLayout>

                    <!-- Inline Bootstrap Error / Retry -->
                    <LinearLayout
                        android:id="@+id/bootstrap_error_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/bootstrap_error_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="36dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorError"
                            tools:text="Extraction failed: disk full" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_retry_bootstrap"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_retry"
                            app:icon="@drawable/ic_refresh" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="12dp" />

                    <!-- PicoClaw Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="4dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_picoclaw"
                            android:contentDescription="@string/icon_picoclaw_desc"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="@string/label_picoclaw"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <!-- PicoClaw status chip -->
                        <com.google.android.material.chip.Chip
                            android:id="@+id/status_picoclaw_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_picoclaw_stopped"
                            android:clickable="false"
                            android:focusable="false"
                            app:chipIcon="@drawable/ic_stop"
                            app:chipIconVisible="true"
                            app:chipIconSize="16dp"
                            app:chipMinHeight="32dp"
                            app:chipStartPadding="8dp"
                            app:chipEndPadding="8dp" />
                    </LinearLayout>

                    <!-- Inline PicoClaw Error -->
                    <TextView
                        android:id="@+id/picoclaw_error_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="36dp"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorError"
                        android:visibility="gone"
                        tools:text="Failed to start: binary not found"
                        tools:visibility="visible" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="12dp" />

                    <!-- Server Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="4dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_server"
                            android:contentDescription="@string/icon_server_desc"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/server_info_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="@string/server_status_default"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <!-- Server health chip -->
                        <com.google.android.material.chip.Chip
                            android:id="@+id/status_server_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_server_offline"
                            android:clickable="false"
                            android:focusable="false"
                            app:chipIcon="@drawable/ic_offline"
                            app:chipIconVisible="true"
                            app:chipIconSize="16dp"
                            app:chipMinHeight="32dp"
                            app:chipStartPadding="8dp"
                            app:chipEndPadding="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========================================== -->
            <!-- INFO CARD                                  -->
            <!-- Explains what PicoClaw is                  -->
            <!-- ========================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/card_info_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/info_picoclaw_description"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:lineSpacingMultiplier="1.2" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_learn_more"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_learn_more"
                        app:icon="@drawable/ic_help" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========================================== -->
            <!-- CONTROLS CARD                              -->
            <!-- Mission Control, Logs, Settings, Restart   -->
            <!-- ========================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="80dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/card_controls_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="12dp" />

                    <!-- 2-column grid of action buttons -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="2"
                        android:useDefaultMargins="true">

                        <!-- Mission Control -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_mission_control"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_gravity="fill_horizontal"
                            android:layout_margin="4dp"
                            android:minHeight="64dp"
                            android:text="@string/btn_mission_control"
                            app:icon="@drawable/ic_globe"
                            app:iconGravity="top"
                            app:iconPadding="4dp"
                            app:iconSize="24dp" />

                        <!-- View Logs -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_view_logs"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_gravity="fill_horizontal"
                            android:layout_margin="4dp"
                            android:minHeight="64dp"
                            android:text="@string/btn_view_logs"
                            app:icon="@drawable/ic_logs"
                            app:iconGravity="top"
                            app:iconPadding="4dp"
                            app:iconSize="24dp" />

                        <!-- Settings -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_settings"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_gravity="fill_horizontal"
                            android:layout_margin="4dp"
                            android:minHeight="64dp"
                            android:text="@string/btn_settings"
                            app:icon="@drawable/ic_settings"
                            app:iconGravity="top"
                            app:iconPadding="4dp"
                            app:iconSize="24dp" />

                        <!-- Restart -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_restart"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_gravity="fill_horizontal"
                            android:layout_margin="4dp"
                            android:minHeight="64dp"
                            android:text="@string/btn_restart"
                            app:icon="@drawable/ic_refresh"
                            app:iconGravity="top"
                            app:iconPadding="4dp"
                            app:iconSize="24dp" />
                    </GridLayout>

                    <!-- Inline error / info message area -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/inline_message_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:visibility="gone"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="?attr/colorErrorContainer"
                        app:strokeWidth="0dp"
                        tools:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_error"
                                android:contentDescription="@string/icon_error_desc"
                                app:tint="?attr/colorOnErrorContainer" />

                            <TextView
                                android:id="@+id/inline_message_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnErrorContainer"
                                tools:text="Mission Control unavailable while server is offline." />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ============================================== -->
    <!-- FLOATING ACTION BUTTON (Primary Action)        -->
    <!-- Icon changes: Play (stopped) -> Stop (running) -->
    <!-- ============================================== -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_primary_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/fab_start_desc"
        app:srcCompat="@drawable/ic_play"
        app:fabSize="normal"
        app:elevation="6dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
